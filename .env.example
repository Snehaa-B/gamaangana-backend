# Database (Supabase / PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Admin login (hardcoded — change in production)
ADMIN_EMAIL=admin@gamaangana.com
ADMIN_PASSWORD=Admin@123
ADMIN_API_TOKEN=gamaangana-admin-dev-token

# Firebase Admin (choose ONE approach)
# Option A — path to downloaded service account JSON (recommended)
FIREBASE_PROJECT_ID=gamaangna
FIREBASE_SERVICE_ACCOUNT_PATH=src/config/firebase-service-account.json

# Option B — inline credentials (private key must use \n for newlines)
# FIREBASE_PROJECT_ID=gamaangna
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@gamaangna.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
